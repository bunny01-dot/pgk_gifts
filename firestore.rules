rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PGK GIFTS PRODUCTION SECURITY RULES
     * 
     * Principles:
     * 1. Public can read products and categories.
     * 2. Only admins can write products/categories.
     * 3. Orders are private: Only admins can read/list them.
     * 4. Orders are created via backend verification logic.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        request.auth.uid == '30S6HkIJXKWWSrmlLD8c8GBskst1'
      );
    }

    // Role-based access control
    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // Product catalog: Publicly readable
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Locked down for privacy
    match /orders/{orderId} {
      allow read: if isAdmin();
      // In a real prod environment, we allow create only if verified by functions
      // For this prototype, we allow create but list/read is restricted to admin
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    // Studio content
    match /websiteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}