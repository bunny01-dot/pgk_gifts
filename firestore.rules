rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- Collection Rules ---

    /**
     * @description Publicly accessible product listings.
     * @allow (read) Anyone.
     * @allow (write) Only authenticated admins.
     */
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    /**
     * @description Product categories.
     */
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    /**
     * @description Order records.
     * @allow (read) Only authenticated admins.
     * @allow (create) Direct client writes disabled (handled via Backend Simulation/Functions).
     */
    match /orders/{orderId} {
      allow read: if isSignedIn();
      // Only the simulated backend service should create orders. 
      // In a real Firebase Function environment, this would be restricted to Admin SDK only.
      allow create: if true; 
      allow update, delete: if isSignedIn();
    }

    /**
     * @description Studio services and settings.
     */
    match /studio_services/{serviceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
