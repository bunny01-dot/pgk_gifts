rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.uid == '30S6HkIJXKWWSrmlLD8c8GBskst1'
          || (request.auth.token.email != null && (
               request.auth.token.email == 'admin@pgk.com'
               || request.auth.token.email == 'kalab320@gmail.com'
             ))
        );
    }
    
    // User-isolated customizations folder
    match /users/{userId}/customizations/{fileName} {
      // Allow reading and deleting if authenticated and the UID matches the folder, or if admin
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      
      // Allow creation and updates under strict size and format constraints
      allow create, update: if isSignedIn() 
                            && request.auth.uid == userId
                            && request.resource.size < 5 * 1024 * 1024 // Enforce 5MB limit
                            && request.resource.contentType.matches('image/.*');
    }

    // Publicly readable product images, but writable only by admins
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Category thumbnail images (homepage Highlighted Collections) — admin only
    match /category-thumbnails/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Portfolio/gallery showcase images — admin only
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Damage/Return photo evidence
    match /returns/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn()
                            && request.resource.size < 5 * 1024 * 1024 // Enforce 5MB limit
                            && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Promotional offer banners — admin only
    match /offers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promotional video files (MP4/WebM) — admin only
    match /promo-videos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
