rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User-isolated customizations folder
    match /users/{userId}/customizations/{fileName} {
      // Allow reading and deleting if authenticated and the UID matches the folder
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      
      // Allow creation and updates under strict size and format constraints
      allow create, update: if request.auth != null 
                            && request.auth.uid == userId
                            && request.resource.size < 5 * 1024 * 1024 // Enforce 5MB limit
                            && (request.resource.contentType == 'image/png' 
                                || request.resource.contentType == 'image/jpeg' 
                                || request.resource.contentType == 'image/jpg' 
                                || request.resource.contentType == 'image/webp');
    }

    // Publicly readable product images, but writable only via Admin SDK
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
